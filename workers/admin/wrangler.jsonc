{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "evolvera-admin",
  "main": "index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "ENABLED": "false", "ADMIN_ORIGIN": "" },
  // Operator page (EP-01 P8), built by `npm run build:admin`. The worker
  // runs first for every request and serves only the two named files.
  "assets": {
    "directory": "../../.admin-build",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Sessions" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessions"] }],
}
